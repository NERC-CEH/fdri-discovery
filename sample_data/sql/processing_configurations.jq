to_entries | map(.key as $site | .value | map(. + {"site": $site})) | flatten | .[] | . + {"raw": . | tostring} | if .dep_ts then . + {"dep_ts": .dep_ts | map({"id": .})} else . end | if .load_ts then . + {"load_ts": .load_ts | map({"id": .})} else . end | if .observation_interval then . + {"obs_start_date": .observation_interval.start_date, "obs_end_date": (.observation_interval.end_date // "")} else . end | if .parameters then . + {"parameters": [.parameters[] | if .structured_value then {"param": .param, "structured_items": [.structured_value | to_entries[] | {"idx": (.key|tostring), "entries": [.value[] | {"child_key": .param, "value": .value}]}]} else . end]} else . end