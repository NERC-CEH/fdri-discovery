        ".zattrs": {
            "Conventions": "CF-1.6",
            "comment": "In line with standard UK convention, the rainfall on a given day refers to the rainfall amount precipitated in 24 hours between 09:00 UTC on that day and 09:00 UTC on the following day.",
            "creator_email": "malngu@ceh.ac.uk, vke@ceh.ac.uk",
            "creator_name": "Maliko Tanguy, Virginie Keller",
            "creator_url": "",
            "date_issued": "2014-01-06",
            "description": "Daily rainfall 1km-gridded dataset created as part of CEH Gridded Estimates of Areal Rainfall (CEH - GEAR). Great Britain.",
            "geospatial_lat_max": 61.026796,
            "geospatial_lat_min": 49.766807,
            "geospatial_lon_max": 3.554013,
            "geospatial_lon_min": -7.55716,
            "grid_mapping": "crs",
            "institution": "CEH Wallingford - NERC",
            "keywords": "rainfall, raingauge, gridded, Natural Neighbour interpolation",
            "licence": "Licensing conditions apply (datalicensing@ceh.ac.uk)",
            "publisher_email": "enquiries@ceh.ac.uk",
            "publisher_name": "Centre for Ecology and Hydrology",
            "publisher_url": "http://www.ceh.ac.uk",
            "reference": "Tanguy, M., Prosdocimi, I., Keller, V.D.J., Terry, J., Cole, S.J., Morris, D.G., Dixon, H. (2014). Consolidation of a CEH reference rainfall dataset for hydrological purposes for the UK. CEH-Wallingford, Oxfordshire, UK.",
            "source": "CEH - GEAR: dataset created using Natural Neighbour method interpolation on UK raingauge data",
            "version_comment": "The version number of each data file corresponds to the dataset version for which the file was originally created. The dataset is updated periodically (normally annually) when new quality controlled raingauge data becomes available. At each update the whole dataset will be given a new version number (v1.1.,v1.2.,v1.3., ...) but some individual data files which comprise that dataset may have an earlier version number. This is because, for a given year, unless the data has changed for that year, the grids will remain unchanged and, as a result, the data file version number for that year will also remain the same. For unchanged years, the same file (with the same original version number) will belong to different dataset versions. The file version for a given year will change if the corresponding grids are updated with new data."
        },
