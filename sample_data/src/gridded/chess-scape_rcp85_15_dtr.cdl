		dtr:_FillValue = -1.e+20f ;
		dtr:standard_name = "air_temperature" ;
		dtr:standard_name_url = "http://vocab.nerc.ac.uk/standard_name/air_temperature/" ;
		dtr:long_name = "Daily near-surface air temperature range" ;
		dtr:units = "K" ;
		dtr:coordinates = "time lon lat" ;
		dtr:grid_mapping = "crsOSGB" ;
