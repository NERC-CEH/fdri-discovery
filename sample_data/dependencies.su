prefix dct: <http://purl.org/dc/terms/>
prefix fdri: <http://fdri.ceh.ac.uk/vocab/metadata/>
prefix sdo: <http://schema.org/>

DROP SILENT GRAPH <http://fdri.ceh.ac.uk/id/dataset/dependency-graph> ;
INSERT {
    GRAPH <http://fdri.ceh.ac.uk/id/dataset/dependency-graph> {
        ?ds fdri:directDependsOn ?dep .
    }
} WHERE {
  # Any configuration argument whose value references a timeseries dataset is a dependency
  ?ds fdri:methodology/dct:hasPart/fdri:configuration/fdri:hasCurrentValue/fdri:argument ?arg .
  ?arg fdri:hasValue/sdo:valueReference ?dep .
  ?dep a fdri:TimeSeriesDataset .
};
INSERT {
    GRAPH <http://fdri.ceh.ac.uk/id/dataset/dependency-graph> {
        ?ds fdri:dependsOn ?dep .
    }
} WHERE {
    ?ds fdri:directDependsOn+ ?dep
}